# Local API settings. Copy this file to .env and fill in the values.
# .env is not committed. A variable already set in Windows overrides this file.
# Start with: mvn spring-boot:run
# The API listens on 127.0.0.1 only.

MYSQL_URL=jdbc:mysql://localhost:3306/mypncinc?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USER=root
MYSQL_PASSWORD=pncroot

SERVER_PORT=8080

JWT_SECRET=
JWT_EXPIRATION=28800000
AUTH_BOOTSTRAP_EMAIL=admin@mypncinc.local
AUTH_BOOTSTRAP_PASSWORD=
AUTH_RESET_LINK_BASE_URL=http://localhost:4200
AUTH_RESET_TOKEN_TTL=3600000

DOCUMENT_STORAGE_ROOT=./data/documents

MAIL_HOST=mail.server265.com
MAIL_PORT=587   
MAIL_USERNAME=mypnc@pnconline.com
MAIL_PASSWORD=App1@pncINC
MAIL_FROM=mypnc@pnconline.com

# Staging API settings. Copy this file to .env.staging beside the folder you start the jar from.
# .env.staging is not committed.
# Start with: java -jar app\pnc-inc-api-0.1.0.jar --spring.profiles.active=staging
# Do not pass -Pstaging to Maven. Staging is selected only when the jar starts.

MYSQL_URL=jdbc:mysql://localhost:3306/mypncinc?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USER=root
MYSQL_PASSWORD=

JWT_SECRET=
AUTH_BOOTSTRAP_EMAIL=admin@mypncinc.local
AUTH_BOOTSTRAP_PASSWORD=
AUTH_RESET_LINK_BASE_URL=http://localhost:8080

DOCUMENT_STORAGE_ROOT=C:\mypncinc\data\documents
WEB_ROOT=C:\mypncinc\web
APP_ORIGINS=http://localhost:8080

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=PNC Inc
MAIL_STARTTLS=true
